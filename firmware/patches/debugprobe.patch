diff --git a/src/probe.c b/src/probe.c
index dbe0ea8..1a960b5 100644
--- a/src/probe.c
+++ b/src/probe.c
@@ -75,8 +75,20 @@ void probe_assert_reset(bool state)
 {
 #if defined(PROBE_PIN_RESET)
     /* Change the direction to out to drive pin to 0 or to in to emulate open drain */
+#if defined(PROBE_PIN_RESET_DIR)
+    /* Level-shifted reset: drive the 3V3 side low before turning the translator towards the target,
+     * and turn it back to input before releasing, so the target never sees a driven high. */
+    if (state == 0) {
+        gpio_set_dir(PROBE_PIN_RESET, GPIO_OUT);
+        gpio_put(PROBE_PIN_RESET_DIR, 1);
+    } else {
+        gpio_put(PROBE_PIN_RESET_DIR, 0);
+        gpio_set_dir(PROBE_PIN_RESET, GPIO_IN);
+    }
+#else
     gpio_set_dir(PROBE_PIN_RESET, state == 0 ? GPIO_OUT : GPIO_IN);
 #endif
+#endif
 }
 
 int probe_reset_level(void)
diff --git a/src/probe.pio b/src/probe.pio
index 5636c0c..1253b19 100644
--- a/src/probe.pio
+++ b/src/probe.pio
@@ -78,6 +78,12 @@ static inline void probe_gpio_init()
     gpio_pull_up(PROBE_PIN_RESET);
     // gpio_init will leave the pin cleared and set as input
     gpio_init(PROBE_PIN_RESET);
+#if defined(PROBE_PIN_RESET_DIR)
+    // translator direction: low = target drives the 3V3 side (reset released)
+    gpio_init(PROBE_PIN_RESET_DIR);
+    gpio_put(PROBE_PIN_RESET_DIR, 0);
+    gpio_set_dir(PROBE_PIN_RESET_DIR, GPIO_OUT);
+#endif
 #endif
     // Funcsel pins
     pio_gpio_init(pio0, PROBE_PIN_SWCLK);
@@ -90,6 +96,9 @@ static inline void probe_gpio_init()
 static inline void probe_gpio_deinit()
 {
 #if defined(PROBE_PIN_RESET)
+#if defined(PROBE_PIN_RESET_DIR)
+	gpio_put(PROBE_PIN_RESET_DIR, 0);
+#endif
 	gpio_deinit(PROBE_PIN_RESET);
 	gpio_disable_pulls(PROBE_PIN_RESET);
 #endif
