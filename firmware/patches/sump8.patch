+# LA_BOARD=v2 selects the level-shifted LA_RP2040 V2 board (non-contiguous inputs, 32-bit samples).
+if (LA_BOARD STREQUAL "v2")
+    target_compile_definitions(logic_analyzer PRIVATE LA_BOARD_V2=1 USBD_PRODUCT="LA-RP2040 V2 SUMP8 v1")
+else ()
